if [ -z "$PS1" ]; then
   return
fi

# [[ -n "$ZSHRC_LOADED" ]] && return
# export ZSHRC_LOADED=1

SOURCE="${(%):-%N}"
while [ -h "$SOURCE" ]; do # resolve $SOURCE until the file is no longer a symlink
  DIR="$( builtin cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE" # if $SOURCE was a relative symlink, we need to resolve it relative to the path where the symlink file was located
done

[[ -n "$ZSH_DEBUG" ]] && echo "Bootstrap loaded from: $SOURCE"

basezshdir=${SOURCE:A:h}
masterzshrc=$basezshdir/zshrc
oszshrc=$masterzshrc-`uname`
localzshrc=$oszshrc-${HOST%%.*}

if [ ! -f $localzshrc ]; then
    printf "zshrc for $localzshrc doesn't exist...makin' it"
    printf '\n# zshrc for local machine\n' > "$localzshrc"
fi

[[ -n "$ZSH_DEBUG" ]] && echo -n "Applicable shell configs: "
for zshfile in "$masterzshrc" "$oszshrc" "$localzshrc"; do
  if [ -r $zshfile ]; then
    . $zshfile
    [[ -n "$ZSH_DEBUG" ]] && echo -n "`basename $zshfile` "
  fi
done
echo

# Set convenience aliases
myed=${EDITOR:-nvim}
alias editzshrc="$myed $masterzshrc"
alias editoszshrc="$myed $oszshrc"
alias editlocalzshrc="$myed $localzshrc"

