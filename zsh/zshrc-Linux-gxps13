
# zshrc for local machine

### Environment variables ###
export PATH=$HOME/.cargo/bin:$HOME/go/bin:$PATH
# Go
if [[ -d /usr/local/go/bin ]]; then
  export PATH="${PATH}:/usr/local/go/bin"
fi
export NVM_DIR="$HOME/.config/nvm"

### Alias ###
alias wireless="nmcli"
alias g++='g++ -Wall -g -O0 -std=c++17'
alias grep='rg'

### Functions ###

# Node version manager (NVM)
# nvm allows you to quickly install and use different versions of node via the command line.
# Lazy NVM: only load when node/npm/nvm is first called
nvm() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"; nvm "$@" }
node() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"; node "$@" }
npm() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"; npm "$@" }
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
